# Copy to release.env (untracked) and fill in. Setup steps: RELEASING.md.

# Name of your "Developer ID Application" certificate, as `security find-identity -p codesigning` lists it.
DEVELOPER_ID="Developer ID Application: Your Name (TEAMID1234)"

# The keychain profile you stored with `xcrun notarytool store-credentials`.
NOTARY_PROFILE="ribbon-notary"

# Where the appcast will be served, and the public key from Sparkle's generate_keys.
SU_FEED_URL="https://example.com/ribbon/appcast.xml"
SU_PUBLIC_ED_KEY="paste-the-public-key-here"

# Optional. Where the DMGs are served; defaults to the folder of SU_FEED_URL.
#DOWNLOAD_URL_PREFIX="https://example.com/ribbon/"
